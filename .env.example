# Protocol: Bunker .env template
# Copy this file to `.env` for source/repo runs.
# Format: KEY=value # short explanation.

# =============================================================================
# 1. Core Settings
# =============================================================================

PORT=3000 # HTTP/WebSocket server port. In portable launchers, 0 means auto-port.
HOST=0.0.0.0 # Bind address. Use 127.0.0.1 for local-only, 0.0.0.0 for LAN/server access.
TRUST_PROXY=false # Set true behind nginx/Caddy/Cloudflare to trust X-Forwarded-* headers.

BUNKER_RULE_BOT_MIN_DELAY_MS=2500 # Minimum delay before a regular bot action.
BUNKER_RULE_BOT_MAX_DELAY_MS=6500 # Maximum delay before a regular bot action.
BUNKER_RULE_BOT_DISCUSSION_MIN_DELAY_MS=10000 # Minimum pause after a bot reveals a card before passing the turn.
BUNKER_RULE_BOT_DISCUSSION_MAX_DELAY_MS=20000 # Maximum pause after a bot reveals a card before passing the turn.

BUNKER_AI_ACCESS_KEYS_FILE=data/ai-access-keys.json # Client AI access-key store used for pbai_* keys.
BUNKER_AI_GATEWAY_BASE_URL= # OpenAI-compatible gateway base URL, e.g. https://api.openai.com/v1.
BUNKER_AI_GATEWAY_API_KEY= # Server-side gateway API key. This is not the client pbai_* key.
BUNKER_AI_GATEWAY_MODEL= # Gateway model id, e.g. gpt-4o-mini or provider-specific model id.
BUNKER_AI_GATEWAY_TIMEOUT_MS=45000 # AI gateway response timeout in milliseconds.

LOG_RETENTION_DAYS=14 # Linux portable launcher: days to keep daily logs; 0 disables cleanup.

# =============================================================================
# 2. Optional Settings
# =============================================================================

# PUBLIC_ORIGIN= # Full public origin for generated links, e.g. https://bunker.example.com.
# PUBLIC_HOST= # Public host/IP fallback for generated links when PUBLIC_ORIGIN is empty.
# DOMAIN= # Domain used by portable domain mode and public-link helpers.

# BUNKER_IDENTITY_MODE=prod # prod/token for normal play, dev_tab for local multi-tab testing.
# BUNKER_DEV_LOGS=false # Enables verbose development logs.
# BUNKER_ENABLE_DEV_SCENARIOS=false # Enables dev-only scenarios.

# BUNKER_ASSETS_ROOT=assets # Path to cards/assets.
# BUNKER_LOCALES_ROOT=locales # Path to localization files.
# BUNKER_CLIENT_DIST=client/dist # Path to the built browser client.
# BUNKER_OVERLAY_PUBLIC_ROOT=server/public/overlay # Path to overlay static files.
# BUNKER_SERVE_CLIENT=true # Set false for API/WebSocket-only server mode.

# BUNKER_BUILD_PROFILE= # Build/runtime profile marker, e.g. public or server.
# BUNKER_LINKS_VISIBILITY=all # Link visibility in logs/UI: all, public, or external.
# BUNKER_DESKTOP_API_SECRET= # Shared secret for desktop API integration.

# BUNKER_ALLOWED_ORIGINS= # Extra allowed origins separated by comma/space/semicolon; same-origin is always allowed.
# BUNKER_ENFORCE_ORIGIN_CHECKS= # 1 forces origin checks, 0 disables them, empty uses auto mode.
# BUNKER_OUTBOUND_SENSITIVE_GUARD=1 # Guards against leaking sensitive outbound payloads.
# BUNKER_OUTBOUND_SENSITIVE_GUARD_STRICT=0 # Strict mode for the outbound sensitive payload guard.
# BUNKER_SENSITIVE_HTTP_RATE_LIMIT=1 # Enables rate limiting for sensitive HTTP routes.
# BUNKER_SENSITIVE_HTTP_RATE_LIMIT_WINDOW_MS=60000 # Rate-limit window in milliseconds.
# BUNKER_SENSITIVE_HTTP_RATE_LIMIT_MAX=120 # Max sensitive HTTP requests per window.

# BUNKER_ROOM_CLEANUP_INTERVAL_MS=60000 # Room cleanup interval in milliseconds.
# BUNKER_ROOM_INACTIVE_TTL_MS=21600000 # TTL for inactive rooms with no connected players.
# BUNKER_ROOM_ENDED_TTL_MS=1800000 # TTL for ended rooms.

# BUNKER_OVERLAY_TOKEN_TTL_MS=0 # Overlay token TTL in milliseconds; 0 disables expiry.
# BUNKER_OVERLAY_CONTROL_INVITE_TTL_MS=600000 # Overlay-control invite TTL in milliseconds.
# BUNKER_SPECTATOR_INVITE_TTL_MS=600000 # Spectator invite TTL in milliseconds.

# BUNKER_DECKS_LAYOUT=auto # Deck asset layout: auto, legacy, or v2.
# BUNKER_ASSET_VARIANT=1x # Asset quality variant, usually 1x or 2x.
# BUNKER_ASSET_LOCALE=ru # Preferred card asset locale.

# VITE_WS_URL= # Build-time WebSocket URL override for the Vite client.
# VITE_API_BASE= # Build-time API base URL override for the Vite client.
# VITE_ASSET_BASE= # Build-time asset base URL override for the Vite client.
# VITE_IDENTITY_MODE=prod # Build-time identity mode for dev client builds.
# BUNKER_CLIENT_SOURCEMAP=0 # Set 1 to emit client sourcemaps during build.

# BUNKER_PORTABLE_NO_BROWSER=0 # Portable launcher only: 1 prevents auto-opening the browser.

# BUNKER_PACK_PRUNE_RUNTIME_NOISE=1 # Pack scripts only: removes runtime noise from artifacts.
# BUNKER_PACK_PARALLEL_ARCHIVE=0 # Pack scripts only: enables parallel Linux artifact archiving.
