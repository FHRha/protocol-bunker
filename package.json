{
  "name": "bunker-browser",
  "version": "0.2.6",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "server",
    "client",
    "shared",
    "scenarios"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --kill-others-on-fail -n server,client \"pnpm -C server dev\" \"pnpm -C client dev\"",
    "sync:icons": "node scripts/sync-icons.mjs",
    "build": "pnpm run sync:icons && pnpm -C shared build && pnpm -C scenarios build && pnpm -C server build && pnpm -C client build",
    "build:all": "pnpm run sync:icons && pnpm -r build",
    "locale:audit": "node scripts/localization-audit.mjs",
    "locale:check": "node scripts/localization-audit.mjs --strict",
    "typecheck": "pnpm -C shared typecheck && pnpm -C scenarios typecheck && pnpm -C server typecheck && pnpm -C client typecheck",
    "test:ws": "pnpm -C shared build && pnpm -C scenarios build && node --test tests/ws.integration.test.mjs",
    "test:install": "node --test tests/install-update.test.mjs",
    "test:integration": "pnpm run test:ws && pnpm run test:install",
    "build:client": "pnpm run sync:icons && pnpm -C client build",
    "build:server": "pnpm -C server build",
    "pack:win": "node scripts/pack-win-portable.mjs",
    "pack:win:base": "node scripts/pack-win-portable.mjs --base-only",
    "pack:win:from-base": "node scripts/pack-win-portable.mjs --from-base",
    "pack:win:all": "node scripts/pack-win-portable.mjs --all-variants",
    "pack:win:hq": "node scripts/pack-win-portable.mjs --asset-variant 2x",
    "pack:linux": "node scripts/pack-linux-portable.mjs",
    "pack:linux:base": "node scripts/pack-linux-portable.mjs --base-only",
    "pack:linux:base:arm64": "node scripts/pack-linux-portable.mjs --arch arm64 --base-only",
    "pack:linux:from-base": "node scripts/pack-linux-portable.mjs --from-base",
    "pack:linux:hq": "node scripts/pack-linux-portable.mjs --asset-variant 2x",
    "pack:linux:arm64": "node scripts/pack-linux-portable.mjs --arch arm64",
    "pack:linux:arm64:hq": "node scripts/pack-linux-portable.mjs --arch arm64 --asset-variant 2x",
    "build:win-exe:launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File win-exe/build/build-launcher.ps1",
    "pack:win-exe": "powershell -NoProfile -ExecutionPolicy Bypass -File win-exe/build.ps1",
    "pack:all": "pnpm run pack:win && pnpm run pack:linux && pnpm run pack:win-exe",
    "start": "node server/dist/index.js",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  }
}
