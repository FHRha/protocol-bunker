{
  "name": "@bunker/server",
  "version": "0.3.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ai:key:create": "tsx src/ai/accessKeysCli.ts create",
    "ai:key:list": "tsx src/ai/accessKeysCli.ts list",
    "ai:key:edit": "tsx src/ai/accessKeysCli.ts edit",
    "ai:key:revoke": "tsx src/ai/accessKeysCli.ts revoke",
    "ai:key:delete": "tsx src/ai/accessKeysCli.ts delete",
    "ai:key:validate": "tsx src/ai/accessKeysCli.ts validate"
  },
  "dependencies": {
    "@bunker/shared": "workspace:*",
    "@bunker/scenarios": "workspace:*",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
