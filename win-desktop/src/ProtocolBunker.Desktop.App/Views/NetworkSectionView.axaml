<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ProtocolBunker.Desktop.Application.ViewModels"
             x:Class="ProtocolBunker.Desktop.App.Views.NetworkSectionView"
             x:DataType="vm:NetworkSectionViewModel"
             mc:Ignorable="d">
  <Grid RowDefinitions="Auto,20,*">
    <Border Background="{StaticResource BunkerPanelRaised}"
            CornerRadius="24"
            Padding="26"
            BorderBrush="{StaticResource BunkerStroke}"
            BorderThickness="1">
      <StackPanel Spacing="10">
        <Border Background="{StaticResource BunkerAccentSoft}"
                BorderBrush="{StaticResource BunkerStroke}"
                BorderThickness="1"
                CornerRadius="999"
                HorizontalAlignment="Left"
                Padding="10,4">
          <TextBlock Text="{Binding T.NetworkBadge}"
                     FontSize="11"
                     FontWeight="Bold"
                     Foreground="{StaticResource BunkerAccent}" />
        </Border>
        <TextBlock Text="{Binding T.NetworkHeroTitle}"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource BunkerText}"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding SettingsStatus}"
                   Foreground="{StaticResource BunkerMuted}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2"
            Background="{StaticResource BunkerPanel}"
            CornerRadius="20"
            Padding="22"
            BorderBrush="{StaticResource BunkerStroke}"
            BorderThickness="1">
      <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,14,Auto,14,Auto,14,Auto,14,Auto,14,Auto,14,Auto">
        <TextBlock Text="{Binding T.NetworkMode}" Foreground="{StaticResource BunkerSubtle}" />
        <ComboBox Grid.Column="1"
                  IsEnabled="{Binding !IsSettingsLocked}"
                  ItemsSource="{Binding ModeOptions}"
                  SelectedIndex="{Binding SelectedModeIndex}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Row="2" Text="{Binding T.NetworkPort}" Foreground="{StaticResource BunkerSubtle}" />
        <TextBox Grid.Row="2"
                 Grid.Column="1"
                 IsEnabled="{Binding !IsSettingsLocked}"
                 Text="{Binding EditablePort}" />

        <TextBlock Grid.Row="4" Text="{Binding T.NetworkPublicHost}" Foreground="{StaticResource BunkerSubtle}" />
        <TextBox Grid.Row="4"
                 Grid.Column="1"
                 IsEnabled="{Binding !IsSettingsLocked}"
                 Text="{Binding EditablePublicHost}" />

        <TextBlock Grid.Row="6" Text="{Binding T.NetworkDomain}" Foreground="{StaticResource BunkerSubtle}" />
        <TextBox Grid.Row="6"
                 Grid.Column="1"
                 IsEnabled="{Binding !IsSettingsLocked}"
                 Text="{Binding EditableDomain}" />

        <TextBlock Grid.Row="8" Text="{Binding T.NetworkDataRoot}" Foreground="{StaticResource BunkerSubtle}" />
        <Grid Grid.Row="8" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Text="{Binding EditableDataRoot}"
                   IsEnabled="{Binding !IsSettingsLocked}" />
          <Button Grid.Column="1"
                  Content="{Binding T.CommonOpen}"
                  Command="{Binding OpenDataRootCommand}" />
        </Grid>

        <CheckBox Grid.Row="10"
                  Grid.ColumnSpan="2"
                  IsEnabled="{Binding !IsSettingsLocked}"
                  Content="{Binding T.NetworkDeveloperMode}"
                  IsChecked="{Binding EditableDeveloperMode}" />

        <TextBlock Grid.Row="12"
                   Grid.ColumnSpan="2"
                   IsVisible="{Binding IsSettingsLocked}"
                   Text="{Binding LockReason}"
                   Foreground="{StaticResource BunkerAccent}"
                   TextWrapping="Wrap" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
