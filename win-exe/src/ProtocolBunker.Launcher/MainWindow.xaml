
<Window x:Class="ProtocolBunker.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Protocol: Bunker - Лаунчер"
        Width="1320"
        Height="900"
        MinWidth="1080"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <SolidColorBrush x:Key="Launcher.WindowBackgroundBrush" Color="#F5F7FA" />
        <SolidColorBrush x:Key="Launcher.PanelBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Launcher.GroupBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Launcher.BorderBrush" Color="#D0D7E2" />
        <SolidColorBrush x:Key="Launcher.TextBrush" Color="#1E2430" />
        <SolidColorBrush x:Key="Launcher.MutedTextBrush" Color="#5A667A" />

        <SolidColorBrush x:Key="Launcher.InputBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Launcher.InputBorderBrush" Color="#C9D3E1" />
        <SolidColorBrush x:Key="Launcher.InputTextBrush" Color="#1E2430" />

        <SolidColorBrush x:Key="Launcher.PrimaryButtonBackgroundBrush" Color="#0B6EF6" />
        <SolidColorBrush x:Key="Launcher.PrimaryButtonForegroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Launcher.SecondaryButtonBackgroundBrush" Color="#E8EDF5" />
        <SolidColorBrush x:Key="Launcher.SecondaryButtonForegroundBrush" Color="#1E2430" />
        <SolidColorBrush x:Key="Launcher.DangerButtonBackgroundBrush" Color="#D94848" />
        <SolidColorBrush x:Key="Launcher.DangerButtonForegroundBrush" Color="#FFFFFF" />

        <SolidColorBrush x:Key="Launcher.LogBackgroundBrush" Color="#F9FBFF" />
        <SolidColorBrush x:Key="Launcher.LogInfoBrush" Color="#1F2937" />
        <SolidColorBrush x:Key="Launcher.LogWarnBrush" Color="#A05A00" />
        <SolidColorBrush x:Key="Launcher.LogErrorBrush" Color="#B91C1C" />

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource Launcher.SecondaryButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource Launcher.SecondaryButtonForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Launcher.BorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Opacity="1"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.9"
                                                             Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" />
                                <Setter TargetName="ButtonBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Launcher.SecondaryButtonBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource Launcher.MutedTextBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}" />

        <Style TargetType="Button" x:Key="PrimaryButtonStyle" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource Launcher.PrimaryButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource Launcher.PrimaryButtonForegroundBrush}" />
        </Style>

        <Style TargetType="Button" x:Key="DangerButtonStyle" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource Launcher.DangerButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource Launcher.DangerButtonForegroundBrush}" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Launcher.TextBrush}" />
        </Style>

        <Style TargetType="Control">
            <Setter Property="Foreground" Value="{DynamicResource Launcher.TextBrush}" />
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource Launcher.TextBrush}" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Launcher.TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box"
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Background="{DynamicResource Launcher.InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource Launcher.InputBorderBrush}">
                                <Path x:Name="Mark"
                                      Data="M 2 8 L 6 12 L 13 3"
                                      StrokeThickness="2"
                                      Stroke="{DynamicResource Launcher.PrimaryButtonBackgroundBrush}"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Launcher.BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Launcher.PrimaryButtonBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Launcher.InputTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource Launcher.InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Launcher.InputBorderBrush}" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource Launcher.TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource Launcher.PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Launcher.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{DynamicResource Launcher.TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource Launcher.PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Launcher.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Launcher.TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,4" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Launcher.SecondaryButtonBackgroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Thumb">
            <Setter Property="Background" Value="{DynamicResource Launcher.BorderBrush}" />
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource Launcher.PanelBackgroundBrush}" />
        </Style>

        <Style x:Key="ComboToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Launcher.InputTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border"
                                Background="{DynamicResource Launcher.InputBackgroundBrush}"
                                BorderBrush="{DynamicResource Launcher.InputBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Margin="8,0,4,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                                <Path Grid.Column="1"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Fill="{DynamicResource Launcher.TextBrush}"
                                      Data="M 0 0 L 8 0 L 4 5 Z" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Launcher.BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Foreground" Value="{DynamicResource Launcher.InputTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource Launcher.InputBackgroundBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Launcher.SecondaryButtonBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Launcher.PrimaryButtonBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource Launcher.PrimaryButtonForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Foreground" Value="{DynamicResource Launcher.InputTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource Launcher.InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Launcher.InputBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Style="{StaticResource ComboToggleButtonStyle}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   Focusable="False">
                                <Border x:Name="DropDownBorder"
                                        Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="300"
                                        BorderBrush="{DynamicResource Launcher.BorderBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource Launcher.PanelBackgroundBrush}"
                                        CornerRadius="6">
                                    <ScrollViewer SnapsToDevicePixels="True" CanContentScroll="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="34" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Hyperlink">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="TextDecorations" Value="Underline" />
            <Setter Property="Foreground" Value="{DynamicResource Launcher.PrimaryButtonBackgroundBrush}" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource Launcher.TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Launcher.BorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource Launcher.GroupBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="LauncherTabControlStyle" TargetType="TabControl">
            <Setter Property="Foreground" Value="{DynamicResource Launcher.TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource Launcher.PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Launcher.BorderBrush}" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="LauncherTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Launcher.TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource Launcher.SecondaryButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Launcher.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Launcher.PanelBackgroundBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Launcher.BorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource Launcher.TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabBorder" Property="Opacity" Value="0.55" />
                                <Setter Property="Foreground" Value="{DynamicResource Launcher.MutedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl" BasedOn="{StaticResource LauncherTabControlStyle}" />
        <Style TargetType="TabItem" BasedOn="{StaticResource LauncherTabItemStyle}" />
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource Launcher.PanelBackgroundBrush}"
                BorderBrush="{DynamicResource Launcher.BorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Protocol: Bunker" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="Windows EXE лаунчер" Margin="0,2,0,0" Foreground="{DynamicResource Launcher.MutedTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Тема" Margin="0,0,0,4" />
                    <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem Tag="System" Content="Системная" />
                        <ComboBoxItem Tag="Light" Content="Светлая" />
                        <ComboBoxItem Tag="Dark" Content="Тёмная" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Версия" Margin="0,0,0,4" />
                    <TextBlock x:Name="HeaderVersionTextBlock" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <CheckBox x:Name="MinimizeToTrayCheckBox"
                              Margin="0,10,0,0"
                              Content="Сворачивать в трей"
                              Checked="MinimizeToTrayCheckBox_Changed"
                              Unchecked="MinimizeToTrayCheckBox_Changed"
                              ToolTip="Если включено, при сворачивании окно будет скрываться в системный трей." />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    Margin="0,12,0,0"
                    Style="{StaticResource LauncherTabControlStyle}"
                    ItemContainerStyle="{StaticResource LauncherTabItemStyle}">
            <TabItem Header="Запуск">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Grid Margin="10" MinWidth="1020">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="Сеть" Margin="0,0,8,8" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Режим" Margin="0,4,8,4" VerticalAlignment="Center" />
                                <ComboBox x:Name="ModeComboBox" Grid.Row="0" Grid.Column="1" Margin="0,2,0,2" SelectionChanged="ModeComboBox_SelectionChanged">
                                    <ComboBoxItem Tag="local" Content="Локальный (HTTP)" />
                                    <ComboBoxItem Tag="domain" Content="Домен (HTTPS)" />
                                </ComboBox>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Порт" Margin="0,4,8,4" VerticalAlignment="Center" />
                                <TextBox x:Name="PortTextBox" Grid.Row="1" Grid.Column="1" Margin="0,2,0,2" TextChanged="PortTextBox_TextChanged" />
                                <TextBlock x:Name="PortValidationTextBlock" Grid.Row="2" Grid.Column="1" Foreground="#C91F37" Visibility="Collapsed" Text="Введите порт в диапазоне 1..65535" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Внешний адрес" Margin="0,4,8,4" VerticalAlignment="Center" />
                                <TextBox x:Name="PublicHostTextBox" Grid.Row="3" Grid.Column="1" Margin="0,2,0,2" TextChanged="PublicHostTextBox_TextChanged"
                                         ToolTip="Внешний IP или домен для доступа извне. Пример: 203.0.113.10 или bunker.example.com" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Foreground="{DynamicResource Launcher.MutedTextBrush}" FontSize="12"
                                           Text="Внешний IP или домен для доступа извне." />
                                <TextBlock x:Name="PublicHostValidationTextBlock" Grid.Row="5" Grid.Column="1" Foreground="#C91F37" Visibility="Collapsed"
                                           Text="Некорректный формат внешнего адреса." />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Домен" Margin="0,4,8,4" VerticalAlignment="Center" />
                                <TextBox x:Name="DomainTextBox" Grid.Row="6" Grid.Column="1" Margin="0,2,0,2" TextChanged="DomainTextBox_TextChanged"
                                         ToolTip="Домен для reverse proxy (например bunker.example.com)" />
                                <TextBlock Grid.Row="7" Grid.Column="1" FontSize="12" Foreground="{DynamicResource Launcher.MutedTextBrush}"
                                           Text="Для режима Домен (через reverse proxy)." />
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="Данные и сессия" Margin="8,0,0,8" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="112" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Папка данных" Margin="0,4,8,4" VerticalAlignment="Center" />
                                <TextBox x:Name="DataFolderTextBox" Grid.Row="0" Grid.Column="1" Margin="0,2,8,2" />
                                <Button Grid.Row="0" Grid.Column="2" Content="Обзор..." Margin="0,0,8,0" Click="BrowseDataFolderButton_Click" />
                                <Button Grid.Row="0" Grid.Column="3" Content="Открыть" Click="OpenDataFolderButton_Click" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Код комнаты" Margin="0,4,8,4" VerticalAlignment="Center" />
                                <TextBox x:Name="RoomCodeTextBox" Grid.Row="1" Grid.Column="1" Margin="0,2,8,2" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Открывать" Margin="0,4,8,4" VerticalAlignment="Center" />
                                <ComboBox x:Name="OpenTargetComboBox" Grid.Row="2" Grid.Column="1" Margin="0,2,8,2" SelectionChanged="OpenTargetComboBox_SelectionChanged">
                                    <ComboBoxItem Tag="internal" Content="Внутренние ссылки" />
                                    <ComboBoxItem Tag="external" Content="Внешние ссылки" />
                                </ComboBox>
                                <Button Grid.Row="2" Grid.Column="2" Content="Оверлей" Margin="0,0,8,0" Click="OpenOverlayButton_Click" />
                                <Button Grid.Row="2" Grid.Column="3" Content="Контроль" Click="OpenControlButton_Click" />
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <Border Grid.Row="1" Padding="10" Margin="0,0,0,8" CornerRadius="8"
                            Background="{DynamicResource Launcher.PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource Launcher.BorderBrush}"
                            BorderThickness="1" x:Name="StatusCard">
                        <Border.RenderTransform>
                            <TranslateTransform Y="0" />
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Margin="0,0,8,0" Text="Статус:" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Margin="0,0,16,0" x:Name="StatusValueTextBlock" />
                            <TextBlock Grid.Column="2" Margin="0,0,8,0" Text="PID:" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Margin="0,0,16,0" x:Name="PidValueTextBlock" />
                            <TextBlock Grid.Column="4" Margin="0,0,8,0" Text="Версия:" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="5" x:Name="VersionValueTextBlock" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" x:Name="LinksCard" Padding="10" Margin="0,0,0,8" CornerRadius="8"
                            Background="{DynamicResource Launcher.PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource Launcher.BorderBrush}"
                            BorderThickness="1">
                        <Border.RenderTransform>
                            <TranslateTransform Y="0" />
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="60" />
                                <RowDefinition Height="60" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Внутренняя (LAN):" FontWeight="SemiBold" Margin="0,10,8,10" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,10,12,10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Hyperlink x:Name="InternalUrlHyperlink" Click="InternalUrlHyperlink_Click">-</Hyperlink>
                            </TextBlock>
                            <Button Grid.Row="0" Grid.Column="2" Content="Открыть" MinWidth="112" Margin="0,8,8,8" VerticalAlignment="Center" HorizontalAlignment="Left" Click="OpenInternalUrlButton_Click" />
                            <Button Grid.Row="0" Grid.Column="3" Content="Копировать" MinWidth="128" Margin="0,8,0,8" VerticalAlignment="Center" HorizontalAlignment="Left" Click="CopyInternalUrlButton_Click" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Внешняя:" FontWeight="SemiBold" Margin="0,10,8,10" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,10,12,10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Hyperlink x:Name="ExternalUrlHyperlink" Click="ExternalUrlHyperlink_Click">-</Hyperlink>
                            </TextBlock>
                            <Button Grid.Row="1" Grid.Column="2" Content="Открыть" MinWidth="112" Margin="0,8,8,8" VerticalAlignment="Center" HorizontalAlignment="Left" Click="OpenExternalUrlButton_Click" />
                            <Button Grid.Row="1" Grid.Column="3" Content="Копировать" MinWidth="128" Margin="0,8,0,8" VerticalAlignment="Center" HorizontalAlignment="Left" Click="CopyExternalUrlButton_Click" />

                            <TextBlock x:Name="ExternalHintTextBlock" Grid.Row="2" Grid.ColumnSpan="4" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Launcher.MutedTextBrush}"
                                       Text="Внешняя ссылка недоступна: укажите Внешний адрес или Домен." />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3" Margin="0,0,0,0" Orientation="Horizontal">
                        <Button x:Name="StartButton" Style="{StaticResource PrimaryButtonStyle}" Content="Запустить сервер" Width="160" Click="StartButton_Click" />
                        <Button x:Name="StopButton" Style="{StaticResource DangerButtonStyle}" Content="Остановить сервер" Width="170" Click="StopButton_Click" />
                        <Button Content="Открыть приложение" Width="160" Click="OpenAppButton_Click" />
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Токены">
                <Grid Margin="10">
                    <GroupBox Header="Токены доступа" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="ToggleTokensButton" Content="Показать токены" Width="150" Click="ToggleTokensButton_Click" />
                                <Button Content="Сгенерировать токены" Width="190" Click="GenerateTokensButton_Click" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Токен хоста" Margin="0,4,8,4" VerticalAlignment="Center" />
                            <TextBox x:Name="HostTokenTextBox" Grid.Row="1" Grid.Column="1" Margin="0,2,8,2" TextChanged="HostTokenTextBox_TextChanged" />
                            <Button Grid.Row="1" Grid.Column="2" Content="Копировать" Click="CopyHostTokenButton_Click" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Токен просмотра" Margin="0,4,8,4" VerticalAlignment="Center" />
                            <TextBox x:Name="ViewTokenTextBox" Grid.Row="2" Grid.Column="1" Margin="0,2,8,2" TextChanged="ViewTokenTextBox_TextChanged" />
                            <Button Grid.Row="2" Grid.Column="2" Content="Копировать" Click="CopyViewTokenButton_Click" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Токен редактирования" Margin="0,4,8,4" VerticalAlignment="Center" />
                            <TextBox x:Name="EditTokenTextBox" Grid.Row="3" Grid.Column="1" Margin="0,2,8,2" TextChanged="EditTokenTextBox_TextChanged" />
                            <Button Grid.Row="3" Grid.Column="2" Content="Копировать" Click="CopyEditTokenButton_Click" />
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem Header="Логи">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Поиск" Margin="0,8,8,0" VerticalAlignment="Center" />
                        <TextBox x:Name="SearchLogTextBox" Width="280" Margin="0,0,12,0" TextChanged="SearchLogTextBox_TextChanged" />
                        <CheckBox x:Name="AutoScrollCheckBox" Content="Автопрокрутка" Margin="0,8,12,0" VerticalAlignment="Center" />
                        <Button Content="Копировать лог" Width="128" Click="CopyLogButton_Click" />
                        <Button Content="Очистить" Width="92" Click="ClearLogButton_Click" />
                    </WrapPanel>

                    <ListBox x:Name="LogListBox"
                             Grid.Row="1"
                             FontFamily="Consolas"
                             FontSize="13"
                             BorderThickness="1"
                             Background="{DynamicResource Launcher.LogBackgroundBrush}"
                             BorderBrush="{DynamicResource Launcher.BorderBrush}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="Обновления">
                <Grid Margin="10">
                    <StackPanel>
                        <TextBlock Text="Проверка обновлений лаунчера и runtime." Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Проверить обновления" Width="200" Click="CheckUpdatesButton_Click" />
                            <Button Content="Открыть релизы" Width="150" Click="OpenReleasesButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Разработка">
                <Grid Margin="10">
                    <GroupBox Header="Параметры разработки" Padding="10">
                        <StackPanel>
                            <CheckBox x:Name="DevModeCheckBox"
                                      Content="Режим разработчика"
                                      Checked="DevModeCheckBox_Changed"
                                      Unchecked="DevModeCheckBox_Changed"
                                      ToolTip="Для локальной разработки: разрешает localhost-ссылки и включает dev-настройки." />
                            <TextBlock x:Name="DevModeStatusTextBlock"
                                       Margin="0,6,0,0"
                                       FontWeight="SemiBold"
                                       Text="Состояние: выключен" />
                            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Launcher.MutedTextBrush}"
                                       Text="Если режим выключен, ссылки формируются только с LAN/внешним адресом без localhost." />
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Margin="0,8,2,0"
                HorizontalAlignment="Right"
                Background="Transparent">
            <TextBlock FontSize="12" Foreground="{DynamicResource Launcher.MutedTextBrush}">
                <Run Text="Сделано FHR · " />
                <Hyperlink Click="FooterGithubHyperlink_Click">github.com/FHRha</Hyperlink>
            </TextBlock>
        </Border>
    </Grid>
</Window>
